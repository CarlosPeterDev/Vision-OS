    <string-array name="tutorial_steps">
        <item>Pinch the Skip button’s window, anywhere on it, to make your first tap.</item>
        <item>Pinch inside the list below and move your hand to scroll it.</item>
        <item>Pinch the bar under a window and move it.</item>
        <item>Pinch the corner at a window’s lower right and drag to resize.</item>
        <item>Hold an open hand still: back of the hand shows Home, palm towards your face opens Control Center.</item>
    </string-array>
